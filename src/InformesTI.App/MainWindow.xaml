<Window x:Class="InformesTI.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Informes TI" Style="{StaticResource AppWindowStyle}" Width="1280" Height="860" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="Save"/></Window.InputBindings>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="98"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="3" Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="58" Height="58" VerticalAlignment="Center" CornerRadius="16" BorderBrush="#35D2E7" BorderThickness="1">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#11506A"/><GradientStop Color="#11213E" Offset="1"/></LinearGradientBrush></Border.Background>
    <TextBlock Text="TI" FontSize="24" FontWeight="Bold" Foreground="#A5F3FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
    <TextBlock Text="ESTUDIO DE INFORMES TÉCNICOS" Foreground="#47C4DB" FontSize="10" FontWeight="Bold"/>
    <TextBlock Text="Informes TI" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="Del trabajo técnico a una entrega profesional." Foreground="#94ABC7" FontSize="13" Margin="0,2,0,0"/>
   </StackPanel>
   <Border Grid.Column="2" VerticalAlignment="Center" Background="#10332F" BorderBrush="#245C53" BorderThickness="1" CornerRadius="16" Padding="14,8"><TextBlock Text="●  DATOS LOCALES" Foreground="#8CE1CC" FontSize="11" FontWeight="SemiBold"/></Border>
  </Grid>
  <Border Grid.Row="1" CornerRadius="16" Padding="14" BorderBrush="#253B54" BorderThickness="1">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#14263C"/><GradientStop Color="#0C1729" Offset="1"/></LinearGradientBrush></Border.Background>
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Button Content="+  Nuevo informe" Click="New_Click" Background="#087C97" BorderBrush="#21ACC4" HorizontalContentAlignment="Left" Margin="0,0,0,18"/>
     <TextBlock Text="HISTORIAL" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,7"/>
     <TextBlock Text="Buscar informes guardados" Foreground="#9AAFC8" FontSize="11" Margin="0,0,0,7"/>
     <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Buscar por empresa, título, ubicación, técnico o número" AutomationProperties.Name="Buscar en el historial"/>
     <TextBlock x:Name="HistoryCount" FontSize="12" Foreground="#94A3B8" Margin="0,8"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
     <Button Content="Exportar respaldo…" Click="Backup_Click" Margin="0,0,0,8"/>
     <Button Content="Importar respaldo…" Click="Restore_Click" Margin="0,0,0,8"/>
     <Button Content="Abrir carpeta de datos" Click="DataFolder_Click" Margin="0"/>
    </StackPanel>
    <ListBox x:Name="HistoryList" SelectionChanged="History_Selected" DisplayMemberPath="Label" AutomationProperties.Name="Informes guardados"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#101D31" BorderBrush="#253B54" BorderThickness="1" CornerRadius="13" Padding="14,12,6,4"><StackPanel>
    <DockPanel Margin="0,0,0,12"><TextBlock x:Name="ReportNumber" Foreground="#67E8F9" FontWeight="Bold"/><TextBlock x:Name="SaveState" Text="Sin guardar" Foreground="#94A3B8" HorizontalAlignment="Right"/></DockPanel>
    <WrapPanel>
     <Button Content="Guardar  ·  Ctrl+S" Click="Save_Click" Background="#0E7490"/>
     <Button Content="Exportar PDF…" Click="Pdf_Click"/>
     <Button Content="Generar correo" Click="Email_Click"/>
     <Button Content="Eliminar informe…" Click="Delete_Click" Foreground="#FDA4AF"/>
    </WrapPanel>
   </StackPanel></Border>
   <TabControl x:Name="EditorTabs" Grid.Row="1" Margin="0,10,0,0">
    <TabItem Header="Datos generales">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,16">
      <TextBlock Text="Datos del mantenimiento" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Empresa, ubicación, título y técnico son obligatorios." Foreground="#94A3B8" Margin="0,5,0,2"/>
      <TextBlock Text="Título del informe *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TitleBox" TextChanged="Editor_Changed" MaxLength="100000"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Empresa *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CompanyBox" TextChanged="Editor_Changed" MaxLength="100000"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Ubicación *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LocationBox" TextChanged="Editor_Changed" MaxLength="100000"/></StackPanel>
      </Grid>
      <TextBlock Text="Técnico responsable *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TechnicianBox" TextChanged="Editor_Changed" MaxLength="100000"/>
      <TextBlock Text="Fechas y tiempos" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,7"/>
      <TextBlock Text="Usa horas de 24 horas (HH:mm). Si el trabajo cruza medianoche, selecciona el día siguiente en la etapa correspondiente." Foreground="#94A3B8"/>
      <Grid Margin="0,16,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions>
       <TextBlock Text="Etapa" Foreground="#94A3B8"/><TextBlock Grid.Column="1" Text="Fecha" Foreground="#94A3B8"/><TextBlock Grid.Column="2" Text="Hora (24 h)" Foreground="#94A3B8"/>
       <TextBlock Grid.Row="1" Text="Inicio del trabajo" VerticalAlignment="Center"/>
       <DatePicker x:Name="StartDate" Grid.Row="1" Grid.Column="1" Margin="0,6,10,6" SelectedDateChanged="Date_Changed" AutomationProperties.Name="Fecha de inicio"/>
       <TextBox x:Name="StartTime" Grid.Row="1" Grid.Column="2" Margin="0,6" TextChanged="Editor_Changed" AutomationProperties.Name="Hora de inicio"/>
       <TextBlock Grid.Row="2" Text="Fin del trabajo físico" VerticalAlignment="Center"/>
       <DatePicker x:Name="PhysicalDate" Grid.Row="2" Grid.Column="1" Margin="0,6,10,6" SelectedDateChanged="Date_Changed" AutomationProperties.Name="Fecha de fin del trabajo físico"/>
       <TextBox x:Name="PhysicalTime" Grid.Row="2" Grid.Column="2" Margin="0,6" TextChanged="Editor_Changed" AutomationProperties.Name="Hora de fin físico"/>
       <TextBlock Grid.Row="3" Text="Fin de recuperación de sistemas" VerticalAlignment="Center"/>
       <DatePicker x:Name="RecoveryDate" Grid.Row="3" Grid.Column="1" Margin="0,6,10,6" SelectedDateChanged="Date_Changed" AutomationProperties.Name="Fecha de fin de recuperación"/>
       <TextBox x:Name="RecoveryTime" Grid.Row="3" Grid.Column="2" Margin="0,6" TextChanged="Editor_Changed" AutomationProperties.Name="Hora de fin de recuperación"/>
      </Grid>
      <Border BorderBrush="#236179" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#123F50"/><GradientStop Color="#132B44" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock x:Name="DurationText" Foreground="#A5F3FC"/></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Trabajo realizado">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,16">
      <TextBlock Text="Detalle técnico" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Cada apartado aparecerá en el PDF y en el correo de entrega." Foreground="#94A3B8" Margin="0,6,0,0"/>
      <TextBlock Text="Actividades realizadas" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ActivitiesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto" TextChanged="Editor_Changed" MaxLength="100000"/>
      <TextBlock Text="Equipos intervenidos" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EquipmentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" TextChanged="Editor_Changed" MaxLength="100000"/>
      <TextBlock Text="Incidencias" Style="{StaticResource FieldLabel}"/><TextBox x:Name="IncidentsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" TextChanged="Editor_Changed" MaxLength="100000"/>
      <TextBlock Text="Resultados" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ResultsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" TextChanged="Editor_Changed" MaxLength="100000"/>
      <TextBlock Text="Pendientes y recomendaciones" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PendingBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" TextChanged="Editor_Changed" MaxLength="100000"/>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Fotografías">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="Evidencia fotográfica" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="JPEG o PNG · Máximo 20 MB por foto, 50 fotos y 250 MB por informe." Foreground="#94A3B8" Margin="0,6,0,16"/>
       <WrapPanel><Button Content="Adjuntar fotos…" Click="AddPhoto_Click"/><Button Content="Subir" Click="PhotoUp_Click"/><Button Content="Bajar" Click="PhotoDown_Click"/><Button Content="Quitar" Click="RemovePhoto_Click"/></WrapPanel>
      </StackPanel>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <ListBox x:Name="PhotosList" SelectionChanged="Photo_Selected" DisplayMemberPath="Label" AutomationProperties.Name="Fotografías en orden de anexos"/>
       <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
        <Border Background="#0B1120" CornerRadius="8" Padding="10"><Image x:Name="PhotoPreview" Stretch="Uniform"/></Border>
        <TextBlock Grid.Row="1" Text="Descripción de la fotografía seleccionada" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="2" x:Name="PhotoDescription" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" TextChanged="PhotoDescription_Changed"/>
       </Grid>
      </Grid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Correo de entrega">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="Listo para copiar" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Guarda el informe y genera el texto actualizado. Adjunta el PDF manualmente en tu cliente de correo. La aplicación no envía mensajes." Foreground="#94A3B8" Margin="0,6,0,16"/>
       <WrapPanel><Button Content="Actualizar correo" Click="Email_Click"/><Button Content="Copiar asunto y mensaje" Click="CopyEmail_Click"/></WrapPanel>
      </StackPanel>
      <TextBox x:Name="EmailBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" AutomationProperties.Name="Asunto y mensaje del correo"/>
     </DockPanel>
    </TabItem>
   </TabControl>
  </Grid>
  <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
   <TextBlock Text="Desarrollado por Ing. Luis Ríos, MBA" DockPanel.Dock="Right" Foreground="#94A3B8" FontSize="12"/>
   <TextBlock x:Name="StatusText" Text="Datos locales · Sin suscripciones" Foreground="#94A3B8" FontSize="12"/>
  </DockPanel>
 </Grid>
</Window>
