<Application x:Class="InformesTI.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#151E30" />
  <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="Background" Value="#0B1120"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#A9BACF"/><Setter Property="Margin" Value="0,14,0,6"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="Background" Value="#111B2B"/>
   <Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3B4B63"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#0E7490"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#22D3EE"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#24334C"/><Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="BorderBrush" Value="#3B4B63"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#67E8F9"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="ItemFrame" Padding="{TemplateBinding Padding}" Background="#151E30" CornerRadius="7"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#164E63"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemFrame" Property="BorderBrush" Value="#22D3EE"/><Setter TargetName="ItemFrame" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#151E30"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#A9BACF"/><Setter Property="Padding" Value="16,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabFrame" Background="#111827" Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#67E8F9"/><Setter TargetName="TabFrame" Property="Background" Value="#151E30"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFrame" Property="BorderThickness" Value="1"/><Setter TargetName="TabFrame" Property="BorderBrush" Value="#67E8F9"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DatePicker"><Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="Background" Value="#111B2B"/><Setter Property="BorderBrush" Value="#3B4B63"/><Setter Property="Padding" Value="4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="Background" Value="#111B2B"/></Style>
 </Application.Resources>
</Application>
